      </component>
      <component id="a8774" class="javax.swing.JButton" binding="addUpdateButton">
        <constraints>
          <grid row="7" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <background color="-2555892"/>
          <enabled value="true"/>
          <foreground color="-16766247"/>
          <hideActionText value="true"/>
