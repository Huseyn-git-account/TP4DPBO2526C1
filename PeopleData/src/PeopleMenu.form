<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="PeopleMenu">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="652" height="430"/>
    </constraints>
    <properties>
      <foreground color="-4110"/>
    </properties>
    <border type="none"/>
    <children>
      <scrollpane id="7d73d">
        <constraints>
          <grid row="1" column="2" row-span="10" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="8c7e" class="javax.swing.JTable" binding="peopleTable">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="d306e" class="javax.swing.JTextField" binding="namaField">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
          <gridbag weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Name"/>
        </properties>
      </component>
      <component id="68e0d" class="javax.swing.JComboBox" binding="kotaComboBox">
        <constraints>
          <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <toolTipText value="City"/>
        </properties>
      </component>
      <component id="7bade" class="javax.swing.JComboBox" binding="kategoriComboBox">
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <toolTipText value="Category"/>
        </properties>
      </component>
      <component id="3a6f2" class="javax.swing.JButton" binding="deleteButton">
        <constraints>
          <grid row="9" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Delete"/>
        </properties>
      </component>
      <component id="b031c" class="javax.swing.JTextField" binding="idField">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
          <gridbag weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="ID"/>
        </properties>
      </component>
      <component id="50f3e" class="javax.swing.JTextField" binding="tahunLahirField">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Birth Year"/>
        </properties>
      </component>
      <component id="92daa" class="javax.swing.JLabel" binding="titleLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Nama Orang"/>
